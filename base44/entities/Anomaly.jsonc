{
  "name": "Anomaly",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "expected": {
      "type": "number"
    },
    "actual": {
      "type": "number"
    },
    "z_score": {
      "type": "number"
    },
    "direction": {
      "type": "string",
      "enum": [
        "high",
        "low"
      ]
    },
    "abs_diff": {
      "type": "number"
    },
    "peak_season": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "store_id",
    "category",
    "date"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.app_role": "owner"
      }
    }
  }
}