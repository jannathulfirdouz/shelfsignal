{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "user": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "entity": {
      "type": "string"
    },
    "record_ref": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "user",
    "action",
    "entity"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "data.app_role": "owner"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "data.app_role": "__none__"
      }
    },
    "delete": {
      "user_condition": {
        "data.app_role": "__none__"
      }
    }
  }
}