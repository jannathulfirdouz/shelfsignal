{
  "name": "DataBatch",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "uploaded_by": {
      "type": "string"
    },
    "rows_in": {
      "type": "number"
    },
    "rows_passed": {
      "type": "number"
    },
    "trust_score": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "file_name",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.app_role": "owner"
      }
    },
    "delete": {
      "user_condition": {
        "data.app_role": "owner"
      }
    }
  }
}