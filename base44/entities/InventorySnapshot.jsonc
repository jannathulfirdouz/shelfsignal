{
  "name": "InventorySnapshot",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "store_id": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "on_hand": {
      "type": "number"
    },
    "on_order": {
      "type": "number"
    },
    "is_simulated": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "date",
    "store_id",
    "sku"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "data.store_id": ""
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.app_role": "owner"
      }
    }
  }
}