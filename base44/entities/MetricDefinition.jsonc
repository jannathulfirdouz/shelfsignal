{
  "name": "MetricDefinition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "formula": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "formula"
  ],
  "rls": {
    "read": {},
