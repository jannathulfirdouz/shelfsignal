{
  "name": "ProductClass",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "abc_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "xyz_class": {
      "type": "string",
      "enum": [
        "X",
        "Y",
        "Z"
      ]
    },
    "cv": {
      "type": "number"
    },
    "revenue_share": {
      "type": "number"
    }
  },
  "required": [
    "store_id",
    "sku"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.app_role": "owner"
      }
    }
  }
}