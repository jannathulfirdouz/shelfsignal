{
  "name": "Recommendation",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "reorder",
        "markdown",
        "investigate",
        "re_engage"
      ]
    },
    "sku": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "customer_ref": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "expected_impact_gbp": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "accepted",
        "rejected"
      ],
      "default": "new"
    },
    "decided_by": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    },
    "decision_note": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "ai_explanation": {
      "type": "string"
    }
  },
  "required": [
    "store_id",
    "type",
    "title",
    "confidence",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        },
        {
          "user_condition": {
            "data.app_role": "viewer"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "store_manager"
              }
            },
            {
              "data.store_id": "{{user.data.store_id}}"
            },
            {
              "data.store_id": {
                "$ne": ""
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.app_role": "owner"
      }
    }
  }
}