{
  "name": "RecommendationExclusion",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "store_id",
    "sku",
    "reason"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    }
  }
}