{
  "name": "SalesHourSummary",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string"
    },
    "weekday": {
      "type": "number"
    },
    "hour": {
      "type": "number"
    },
    "net_revenue": {
      "type": "number"
    },
    "orders": {
      "type": "number"
    }
  },
  "required": [
    "store_id",
    "weekday",
    "hour"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "owner"
          }
        },
        {
          "user_condition": {
            "data.app_role": "analyst"
          }
        }
      ]
    }
  }
}